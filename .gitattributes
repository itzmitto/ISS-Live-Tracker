# Kotlin
*.kt linguist-language=Kotlin linguist-detectable=true
*.kts linguist-language=Kotlin linguist-detectable=true

# Frontend uitsluiten
*.js linguist-detectable=false
*.jsx linguist-detectable=false
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.html linguist-detectable=false
*.css linguist-detectable=false
*.scss linguist-detectable=false

# Configuratie uitsluiten
*.json linguist-detectable=false
*.xml linguist-detectable=false
*.yaml linguist-detectable=false
*.yml linguist-detectable=false
*.toml linguist-detectable=false
*.sh linguist-detectable=false

# Generated en dependencies
/build/** linguist-generated=true
/.gradle/** linguist-generated=true
/node_modules/** linguist-vendored
/dist/** linguist-generated=true
/coverage/** linguist-generated=true
/src/main/resources/static/css/styles.css linguist-generated=true

# Gradle wrappers
/gradlew linguist-generated=true
/gradlew.bat linguist-generated=true
/gradle/wrapper/** linguist-generated=true

# Binary assets
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary