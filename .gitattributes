# Kotlin
*.kt linguist-language=Kotlin
*.kts linguist-language=Kotlin

# Frontend
*.js linguist-language=JavaScript
*.html linguist-language=HTML
*.css linguist-language=CSS

# Generated Tailwind CSS
/src/main/resources/static/css/styles.css linguist-generated=true

# Generated and dependencies
/build/** linguist-generated=true
/.gradle/** linguist-generated=true
/node_modules/** linguist-vendored
/dist/** linguist-generated=true
/coverage/** linguist-generated=true

# Gradle wrappers
/gradlew linguist-generated=true
/gradlew.bat linguist-generated=true
/gradle/wrapper/** linguist-generated=true

# Binary assets
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
